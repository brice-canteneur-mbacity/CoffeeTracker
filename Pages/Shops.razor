@*
    Liste des Shops (entité, depuis DB v5). Chaque ligne agrège : nb de visites, note moyenne,
    date de dernière visite, photo dérivée du shop ou de la visite la + récente.
    Toggle vue liste / vue carte (Leaflet, 1 marker par shop). Click sur une carte → /shops/{id}.
*@
@page "/shops"
@implements IAsyncDisposable
@implements IDisposable
@inject CoffeeDb Db
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject PlaceSearchService PlaceSearch
@inject LocalizationService Loc

<PageTitle>@Loc.T("shops.title")</PageTitle>

<PageHeader Title="@Loc.T("shops.title")"
            Subtitle="@Loc.T("shops.subtitle", _aggregates.Count, _aggregates.Count > 1 ? "s" : "", _totalVisits, _totalVisits > 1 ? "s" : "")">
    <Action>
        <MudIconButton Icon="@(_mapMode ? Icons.Material.Filled.ViewList : Icons.Material.Filled.Map)"
                       Size="Size.Medium"
                       OnClick="ToggleMapModeAsync"
                       aria-label="@(_mapMode ? Loc.T("shops.toggle_to_list") : Loc.T("shops.toggle_to_map"))" />
        <MudIconButton Icon="@Icons.Material.Filled.Add"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       Size="Size.Medium"
                       OnClick="@(() => Nav.NavigateTo("shops/new"))" />
    </Action>
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else
{
    <MudTextField @bind-Value="_search" Placeholder="@Loc.T("shops.search_placeholder")"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true" Immediate="true" DebounceInterval="150" />

    var filtered = Filter(_aggregates);
    var hasSearch = !string.IsNullOrWhiteSpace(_search);
    var withCoords = filtered.Count(a => a.Shop.Latitude is not null && a.Shop.Longitude is not null);

    if (_mapMode)
    {
        <div class="d-flex flex-wrap mb-2" style="gap:8px;">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Explore"
                       OnClick="SearchNearbyAsync"
                       Disabled="@(_searchingNearby || !_googleConfigured)">
                @(_searchingNearby ? Loc.T("nearby.searching") : Loc.T("nearby.button"))
            </MudButton>
            @if (_suggestions.Count > 0)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="ClearSuggestionsAsync">
                    @Loc.T("nearby.clear", _suggestions.Count)
                </MudButton>
            }
            @if (!_googleConfigured)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary align-self-center">
                    @Loc.T("nearby.requires_google_key")
                </MudText>
            }
        </div>
        <div id="@MapElementId" class="shops-map"></div>
        if (filtered.Count == 0)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block text-center">
                @Loc.T("shops.map_no_data")
            </MudText>
        }
        else if (withCoords == 0)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block text-center">
                @Loc.T("shops.map_no_coords", filtered.Count)
            </MudText>
        }
        else if (withCoords < filtered.Count)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block text-center">
                @Loc.T("shops.map_partial", withCoords, filtered.Count)
            </MudText>
        }
    }
    else if (filtered.Count == 0)
    {
        <MudPaper Class="pa-8 d-flex flex-column align-center" Elevation="0">
            <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Large" Class="mb-3" Style="color: var(--coffee-accent-soft)" />
            @if (hasSearch)
            {
                <MudText Typo="Typo.h6">@Loc.T("shops.empty_search_title")</MudText>
                <MudText Class="mud-text-secondary">@Loc.T("shops.empty_search_for", _search)</MudText>
            }
            else
            {
                <MudText Typo="Typo.h6">@Loc.T("shops.empty")</MudText>
                <MudText Class="mb-4 mud-text-secondary">@Loc.T("shops.empty_hint")</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => Nav.NavigateTo("shops/new"))">@Loc.T("shops.cta_add")</MudButton>
            }
        </MudPaper>
    }
    else
    {
    <MudStack Spacing="2">
        @foreach (var a in filtered)
        {
            <MudPaper Class="pa-3 shop-card" Elevation="0"
                      @onclick="@(() => Nav.NavigateTo($"shops/{a.Shop.Id}"))">
                <div class="d-flex" style="gap:12px;">
                    @if (!string.IsNullOrEmpty(a.PhotoDataUrl))
                    {
                        <img src="@a.PhotoDataUrl" alt="" class="thumb-md" />
                    }
                    else
                    {
                        <div class="thumb-md thumb-placeholder">
                            <MudIcon Icon="@Icons.Material.Filled.Storefront" />
                        </div>
                    }
                    <div style="flex:1; min-width:0;">
                        <div class="d-flex align-start justify-space-between" style="gap:8px;">
                            <MudText Style="font-weight:600;" Class="text-truncate">@a.Shop.Name</MudText>
                            @if (a.VisitCount > 0)
                            {
                                <StarRating Value="@((decimal)a.AverageRating)" ReadOnly="true" Size="Size.Small" />
                            }
                        </div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                            @if (!string.IsNullOrEmpty(a.Shop.City) || !string.IsNullOrEmpty(a.Shop.Country))
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" />
                                <span>@(string.Join(", ", new[] { a.Shop.City, a.Shop.Country }.Where(s => !string.IsNullOrEmpty(s))))</span>
                                <span> · </span>
                            }
                            <span>
                                @if (a.VisitCount == 0)
                                {
                                    <span>@Loc.T("shops.no_visits")</span>
                                }
                                else
                                {
                                    <span>@Loc.T("shops.visit_count", a.VisitCount, a.VisitCount > 1 ? "s" : "")</span>
                                    @if (a.LastVisitDate is DateOnly d)
                                    {
                                        <span> · @Loc.T("shops.last_visit", Format.Date(d))</span>
                                    }
                                }
                            </span>
                        </MudText>
                    </div>
                </div>
            </MudPaper>
        }
    </MudStack>
    }
}

<style>
    .shop-card { border: 1px solid var(--coffee-border); cursor: pointer; transition: transform .08s; }
    .shop-card:active { transform: scale(.99); }
    .thumb-md { width: 56px; height: 56px; border-radius: 12px; flex-shrink: 0; object-fit: cover; }
    .thumb-placeholder { background: var(--coffee-surface-soft); display: flex; align-items: center; justify-content: center; color: var(--coffee-accent-soft); }
    .shops-map {
        height: calc(100vh - 260px);
        min-height: 320px;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--coffee-border);
    }
    .shops-map .leaflet-container { font-family: inherit; }
</style>

@code {
    private const string MapElementId = "shops-map";

    private bool _loading = true;
    private List<ShopAggregate> _aggregates = new();
    private int _totalVisits;
    private string _search = string.Empty;
    private bool _mapMode;
    private bool _mapInitialized;

    // « Cafés bien notés à proximité » (Google) — affichés en couche séparée sur la carte.
    private const int NearbyRadiusMeters = 1000;
    private const double NearbyMinRating = 4.5;
    private const int NearbyMinRatingCount = 10;

    private List<NearbyCafe> _suggestions = new();
    private bool _searchingNearby;
    private bool _googleConfigured;
    private DotNetObjectReference<Shops>? _selfRef;

    private record ShopAggregate(
        Shop Shop,
        int VisitCount,
        double AverageRating,
        DateOnly? LastVisitDate,
        string? PhotoDataUrl);

    private List<ShopAggregate> Filter(List<ShopAggregate> list)
    {
        if (string.IsNullOrWhiteSpace(_search)) return list;
        var q = _search.Trim();
        var sc = StringComparison.OrdinalIgnoreCase;
        return list.Where(a =>
            a.Shop.Name.Contains(q, sc)
            || (a.Shop.City?.Contains(q, sc) ?? false)
            || (a.Shop.Country?.Contains(q, sc) ?? false)
            || (a.Shop.Address?.Contains(q, sc) ?? false)
        ).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        Loc.LanguageChanged += OnLangChanged;
        var shops = await Db.Shops.ToCollection().ToList();
        var visits = await Db.ShopVisits.ToCollection().ToList();
        _totalVisits = visits.Count;

        var visitsByShop = visits
            .GroupBy(v => v.ShopId)
            .ToDictionary(g => g.Key, g => g.ToList());

        _aggregates = shops
            .Select(s =>
            {
                var vs = visitsByShop.TryGetValue(s.Id, out var list) ? list : new List<CoffeeShopVisit>();
                var avg = vs.Count > 0 ? vs.Average(v => (double)v.Rating) : 0;
                var last = vs.Count > 0 ? vs.Max(v => v.Date) : (DateOnly?)null;
                var photo = !string.IsNullOrEmpty(s.PhotoDataUrl)
                    ? s.PhotoDataUrl
                    : vs.OrderByDescending(v => v.Date)
                        .Select(v => v.PhotoDataUrl)
                        .FirstOrDefault(p => !string.IsNullOrEmpty(p));
                return new ShopAggregate(s, vs.Count, avg, last, photo);
            })
            // Tri : shops avec visites récentes d'abord, puis sans visite par création récente.
            .OrderByDescending(a => a.LastVisitDate ?? DateOnly.MinValue)
            .ThenByDescending(a => a.Shop.CreatedAt)
            .ToList();

        _loading = false;
        var key = await PlaceSearch.GetGoogleKeyAsync();
        _googleConfigured = !string.IsNullOrEmpty(key);
    }

    private async Task SearchNearbyAsync()
    {
        if (_searchingNearby) return;
        _searchingNearby = true;
        try
        {
            var loc = await PlaceSearch.GeolocateAsync();
            var cafes = await PlaceSearch.SearchNearbyCafesAsync(
                loc.Latitude, loc.Longitude, NearbyRadiusMeters, NearbyMinRating, NearbyMinRatingCount);
            _suggestions = cafes ?? new();

            if (_suggestions.Count == 0)
            {
                Snackbar.Add(Loc.T("nearby.snack_empty"), Severity.Info);
            }
            else
            {
                _selfRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("coffeeMap.showSuggestions", MapElementId, _suggestions, _selfRef);
                Snackbar.Add(Loc.T("nearby.snack_found", _suggestions.Count), Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _searchingNearby = false;
            StateHasChanged();
        }
    }

    private async Task ClearSuggestionsAsync()
    {
        _suggestions = new();
        try { await JS.InvokeVoidAsync("coffeeMap.clearSuggestions", MapElementId); } catch { }
    }

    private async Task ToggleMapModeAsync()
    {
        _mapMode = !_mapMode;
        if (!_mapMode && _suggestions.Count > 0)
        {
            // La couche suggestion est détruite avec la carte ; on aligne l'état C# pour
            // que le bouton « Effacer » ne reste pas avec un compteur fantôme au retour.
            _suggestions = new();
        }
        await Task.CompletedTask;
    }

    /// <summary>Invoqué depuis le popup Leaflet quand l'utilisateur clique sur un café suggéré.</summary>
    [JSInvokable]
    public async Task OnSuggestionClick(string externalId)
    {
        var cafe = _suggestions.FirstOrDefault(s => s.ExternalId == externalId);
        if (cafe is null) return;

        var parameters = new DialogParameters { ["Cafe"] = cafe };
        var dialog = await Dialogs.ShowAsync<SuggestionActionDialog>(Loc.T("nearby.dialog_title"), parameters);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;

        var action = result.Data as string;
        if (action == "add") await AddCafeAsShopAsync(cafe);
        else if (action == "visit") await CreateVisitForCafeAsync(cafe);
    }

    private async Task AddCafeAsShopAsync(NearbyCafe cafe)
    {
        var existing = await FindShopByExternalIdAsync(cafe.ExternalId);
        if (existing is not null)
        {
            Snackbar.Add(Loc.T("nearby.snack_already_added", existing.Name), Severity.Info);
            Nav.NavigateTo($"shops/{existing.Id}");
            return;
        }

        var shop = new Shop
        {
            Name = cafe.Name,
            City = cafe.City,
            Country = cafe.Country,
            Address = cafe.Address,
            Latitude = cafe.Latitude,
            Longitude = cafe.Longitude,
            ExternalPlaceId = cafe.ExternalId,
            CreatedAt = DateTime.UtcNow,
            UpdatedAt = DateTime.UtcNow
        };
        var newId = await Db.Shops.Add(shop);
        Snackbar.Add(Loc.T("nearby.snack_added", cafe.Name), Severity.Success);
        Nav.NavigateTo($"shops/{newId}");
    }

    private async Task CreateVisitForCafeAsync(NearbyCafe cafe)
    {
        // Crée le Shop s'il n'existe pas déjà (par ExternalPlaceId), puis ouvre le formulaire de visite.
        var existing = await FindShopByExternalIdAsync(cafe.ExternalId);
        int shopId;
        if (existing is not null)
        {
            shopId = existing.Id;
        }
        else
        {
            var shop = new Shop
            {
                Name = cafe.Name,
                City = cafe.City,
                Country = cafe.Country,
                Address = cafe.Address,
                Latitude = cafe.Latitude,
                Longitude = cafe.Longitude,
                ExternalPlaceId = cafe.ExternalId,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };
            shopId = await Db.Shops.Add(shop);
        }
        Nav.NavigateTo($"shops/{shopId}/visits/new");
    }

    private async Task<Shop?> FindShopByExternalIdAsync(string externalId)
    {
        if (string.IsNullOrEmpty(externalId)) return null;
        var shops = await Db.Shops.ToCollection().ToList();
        return shops.FirstOrDefault(s =>
            string.Equals(s.ExternalPlaceId, externalId, StringComparison.OrdinalIgnoreCase));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading) return;

        if (_mapMode)
        {
            var markers = Filter(_aggregates).Select(a => new
            {
                id = a.Shop.Id,
                shopName = a.Shop.Name,
                city = a.Shop.City,
                visitCount = a.VisitCount,
                rating = a.VisitCount > 0 ? Math.Round(a.AverageRating, 1) : 0d,
                latitude = a.Shop.Latitude,
                longitude = a.Shop.Longitude,
                lastVisitLabel = a.LastVisitDate is DateOnly d ? Format.Date(d) : null
            }).ToArray();

            if (!_mapInitialized)
            {
                await JS.InvokeVoidAsync("coffeeMap.init", MapElementId, markers);
                _mapInitialized = true;
            }
            else
            {
                await JS.InvokeVoidAsync("coffeeMap.update", MapElementId, markers);
            }
        }
        else if (_mapInitialized)
        {
            try { await JS.InvokeVoidAsync("coffeeMap.destroy", MapElementId); } catch { }
            _mapInitialized = false;
        }
    }

    private void OnLangChanged() => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Loc.LanguageChanged -= OnLangChanged;
        _selfRef?.Dispose();
        _selfRef = null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_mapInitialized)
        {
            try { await JS.InvokeVoidAsync("coffeeMap.destroy", MapElementId); } catch { }
            _mapInitialized = false;
        }
    }
}
